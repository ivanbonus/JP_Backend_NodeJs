// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MÓDULO CLIENTES
// ==========================================

model Cliente {
  id             Int       @id @default(autoincrement())
  nombre         String
  apellidos      String?
  documento      String?   @unique // DNI o RUC
  tipoDocumento  String?   @default("DNI")
  email          String?   
  telefono       String?
  direccion      String?
  fechaRegistro  DateTime  @default(now())

  // Relaciones
  vehiculos      Vehiculo[]
  guias          NumeroGuia[]
  citas          Cita[]
  transacciones  Transaccion[]
  movimientosBancarios MovimientoBancario[]
}

model Cotizacion {
  id             Int       @id @default(autoincrement())
  nombre         String
  email          String
  telefono       String
  vehiculo       String
  placa          String?
  documento      String?
  atencion       String?
  direccion      String?
  servicio       String
  mensaje        String
  estado         String    @default("PENDIENTE") // PENDIENTE, ATENDIDO, RECHAZADO
  fecha          DateTime  @default(now())
  datosCotizacion Json?
}

model Resena {
  id             Int       @id @default(autoincrement())
  nombre         String
  email          String?
  vehiculo       String?
  servicio       String?
  calificacion   Float     // 1 a 5, permite medios puntos
  comentario     String
  respuesta      String?
  estado         String    @default("Pendiente") // Pendiente, Publicada, Rechazada
  fecha          DateTime  @default(now())
}

// ==========================================
// MÓDULO TALLER
// ==========================================

model Vehiculo {
  id             Int       @id @default(autoincrement())
  placa          String    @unique
  marca          String
  modelo         String
  anio           Int?
  color          String?
  clienteId      Int

  cliente        Cliente   @relation(fields: [clienteId], references: [id])
  guias          NumeroGuia[]
  citas          Cita[]
}

model NumeroGuia {
  id             Int       @id @default(autoincrement())
  fechaRecepcion DateTime  @default(now())
  estado         String    @default("PENDIENTE") // PENDIENTE, EN_PROCESO, FINALIZADO, ENTREGADO
  diagnostico    String?
  observaciones  String?
  
  // Relaciones
  clienteId      Int
  vehiculoId     Int

  cliente        Cliente   @relation(fields: [clienteId], references: [id])
  vehiculo       Vehiculo  @relation(fields: [vehiculoId], references: [id])
  
  tecnicos       Trabajador[] @relation("GuiaTrabajadores")
  movimientosInventario MovimientoInventario[]
  transacciones  Transaccion[]
  detalles       GuiaDetalle[]
  movimientosBancarios MovimientoBancario[]
}

model Cita {
  id             Int       @id @default(autoincrement())
  fechaHora      DateTime
  motivo         String
  estado         String    @default("PROGRAMADA") // PROGRAMADA, ATENDIDA, CANCELADA

  clienteId      Int
  vehiculoId     Int

  cliente        Cliente   @relation(fields: [clienteId], references: [id])
  vehiculo       Vehiculo  @relation(fields: [vehiculoId], references: [id])
}

model GuiaDetalle {
  id             Int       @id @default(autoincrement())
  descripcion    String
  cantidad       Int       @default(1)
  precioUnit     Float     @default(0)
  
  numeroGuiaId   Int
  numeroGuia     NumeroGuia @relation(fields: [numeroGuiaId], references: [id], onDelete: Cascade)
}

// ==========================================
// MÓDULO PERSONAL
// ==========================================

model Trabajador {
  id               Int       @id @default(autoincrement())
  nombre           String
  apellidos        String
  dni              String    @unique
  rol              String    @default("TECNICO") // ADMIN, RECEPCION, TECNICO
  telefono         String?
  estado           Boolean   @default(true) // Activo o no
  
  // Nuevos campos para planilla
  sueldoBase       Float     @default(0)
  porcentajeAfp    Float     @default(0) // % de descuento por AFP/ONP
  porcentajeSeguro Float     @default(0) // % de descuento por Seguro

  // Campos adicionales de perfil
  email            String?
  direccion        String?
  observaciones    String?
  fechaIngreso     String?
  proximoPago      String?

  asistencias      Asistencia[]
  guias            NumeroGuia[] @relation("GuiaTrabajadores") // M:N
}

model Asistencia {
  id             Int       @id @default(autoincrement())
  trabajadorId   Int
  fecha          DateTime  @default(now())
  horaEntrada    DateTime?
  horaSalida     DateTime?

  trabajador     Trabajador @relation(fields: [trabajadorId], references: [id])
}

// ==========================================
// MÓDULO INVENTARIO
// ==========================================

model Producto {
  id             Int       @id @default(autoincrement())
  sku            String    @unique
  nombre         String
  descripcion    String?
  categoria      String?
  marca          String?
  precio         Float
  stockActual    Int       @default(0)
  stockMinimo    Int       @default(0)
  foto           String?
  visibleEnWeb   Boolean   @default(false)

  movimientos    MovimientoInventario[]
}

model MovimientoInventario {
  id             Int       @id @default(autoincrement())
  productoId     Int
  tipo           String    // ENTRADA, SALIDA
  cantidad       Int
  motivo         String?   // COMPRA, USO_TALLER, VENTA_DIRECTA, AJUSTE
  fecha          DateTime  @default(now())
  
  // Relación opcional con OT si salió para un taller
  numeroGuiaId   Int?

  producto       Producto  @relation(fields: [productoId], references: [id])
  numeroGuia     NumeroGuia? @relation(fields: [numeroGuiaId], references: [id])
}

// ==========================================
// MÓDULO FINANZAS
// ==========================================

model Transaccion {
  id             Int       @id @default(autoincrement())
  numero         String    @unique // Ej: TXN-001
  tipo           String    // INGRESO, EGRESO
  monto          Float
  metodoPago     String    // EFECTIVO, TARJETA, YAPE, TRANSFERENCIA
  concepto       String
  categoria      String    @default("Otros") // Venta, Servicio, etc
  fecha          String    // Formato DD/MM/YYYY para coincidir con front
  hora           String    // Formato HH:mm
  estado         String    @default("COMPLETADO") // PENDIENTE, PARCIAL, POR_VERIFICAR, COMPLETADO, ANULADO
  nota           String?
  cierreCajaId   Int?

  // Pagos en partes: cada pago (adelanto o abono) es una transacción COMPLETADO con ventaId,
  // con la fecha y el método del día en que se recibió. La venta queda con pagoEnPartes = true
  // y NO se suma como ingreso (lo que entra a caja son sus pagos).
  ventaId        Int?
  pagoEnPartes   Boolean   @default(false)

  // Pedidos web: el pago se verifica antes de contarlo como ingreso
  operacionCliente String?  // n.º de operación que informó el cliente
  verificadoPor  String?
  verificadoEn   DateTime?
  motivoAnulacion String?

  // Relaciones
  clienteId      Int?
  clienteNombre  String?   // Para guardar un cliente que no está registrado
  numeroGuiaId   Int?

  cliente        Cliente?  @relation(fields: [clienteId], references: [id])
  numeroGuia     NumeroGuia? @relation(fields: [numeroGuiaId], references: [id])
  cierreCaja     CierreCaja? @relation(fields: [cierreCajaId], references: [id])
  venta          Transaccion?  @relation("PagosDeVenta", fields: [ventaId], references: [id])
  pagos          Transaccion[] @relation("PagosDeVenta")
  movimientosBancarios MovimientoBancario[]

  @@index([ventaId])
  @@index([estado])
}

model CierreCaja {
  id             Int       @id @default(autoincrement())
  fechaApertura  DateTime  @default(now())
  fechaCierre    DateTime?
  montoInicial   Float     @default(0)
  montoFinal     Float?
  estado         String    @default("ABIERTA") // ABIERTA, CERRADA
  observaciones  String?

  transacciones  Transaccion[]
}

// ==========================================
// MÓDULO SEGURIDAD Y USUARIOS
// ==========================================
model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String?  // Opcional para usuarios de Google
  googleId  String?  @unique
  rol       String   @default("USER") // ADMIN, OPERADOR, CONTABILIDAD, USER
  fecha     DateTime @default(now())
  debeCambiarPassword Boolean @default(false)
  sesionVersion       Int     @default(0)
}

// ==========================================
// CONFIGURACIÓN (Taller y Credenciales)
// ==========================================
model Configuracion {
  id                Int      @id @default(1)
  nombreResponsable String   @default("Administrador")
  email             String   @default("admin@tallerjp.com")
  telefono          String   @default("+51 999 888 777")
  nombreTaller      String   @default("Frenos y Embragues Juan Pablo")
  ruc               String   @default("20601234567")
  direccion         String   @default("Av. Los Mecánicos 123, Lima")
  
  // Seguridad (la contraseña se guarda cifrada con bcrypt; sin valor por defecto)
  usuario             String   @default("administrador")
  password            String
  debeCambiarPassword Boolean  @default(false)
  sesionVersion       Int      @default(0) // Al cambiar la contraseña se invalidan las sesiones anteriores

  // Notificaciones (Opcional por ahora)
  notifEmail        Boolean  @default(true)
  notifSMS          Boolean  @default(false)
  notifApp          Boolean  @default(true)

  // Control bancario: operaciones mayores a este monto (en soles) requieren revisión administrativa
  umbralRevision    Decimal  @default(2000) @db.Decimal(14, 2)
}

// ==========================================
// MÓDULO WEB (Formularios Adicionales)
// ==========================================

model Reclamacion {
  id                     Int      @id @default(autoincrement())
  nombres                String
  apellidos              String
  tipoDocumento          String
  numeroDocumento        String
  direccion              String
  departamento           String
  provincia              String
  distrito               String
  email                  String
  telefonoCelular        String
  telefonoFijo           String?
  bienContratado         String
  descripcionBien        String   @db.Text
  tipoReclamacion        String
  descripcionReclamacion String   @db.Text
  aceptaPrivacidad       Boolean  @default(true)
  estado                 String   @default("PENDIENTE") // PENDIENTE, ATENDIDO
  fecha                  DateTime @default(now())
}

model Postulacion {
  id               Int      @id @default(autoincrement())
  nombres          String
  apellidoPaterno  String
  apellidoMaterno  String
  tipoDocumento    String
  numeroDocumento  String
  direccion        String
  departamento     String
  provincia        String
  distrito         String
  email            String
  telefono         String
  areaPostula      String
  aceptaPrivacidad Boolean  @default(true)
  estado           String   @default("REVISION") // REVISION, CONTACTADO, DESCARTADO
  fecha            DateTime @default(now())
}
model CitaWeb {
  id              Int      @id @default(autoincrement())
  nombre          String
  email           String
  telefono        String
  vehiculo        String
  mensaje         String?
  fechaCita       DateTime
  estado          String   @default("PENDIENTE") // PENDIENTE, CONFIRMADA, CANCELADA
  fechaSolicitud  DateTime @default(now())
}

model BloqueoCita {
  id          Int      @id @default(autoincrement())
  fecha       DateTime // Fecha bloqueada
  todoElDia   Boolean  @default(true)
  horaInicio  String?  // Ej: "08:00"
  horaFin     String?  // Ej: "17:00"
  motivo      String?
  fechaRegistro DateTime @default(now())
}

model Novedad {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String   @db.Text
  etiqueta    String?
  imagen      String?  @db.Text
  videoUrl    String?
  likes       Int      @default(0)
  estado      String   @default("ACTIVO") // ACTIVO, INACTIVO
  fecha       DateTime @default(now())
}

// ==========================================
// SEGURIDAD: VERIFICACIÓN EN DOS PASOS (TOTP)
// ==========================================
model SegundoFactor {
  id                  Int       @id @default(autoincrement())
  cuenta              String    @unique // "config" (administrador principal) o "usuario:<id>"
  activo              Boolean   @default(false)
  codigosRecuperacion String[]  // Hashes bcrypt de los códigos de recuperación (compartidos por la cuenta)
  activadoEn          DateTime?
  creadoEn            DateTime  @default(now())
  actualizadoEn       DateTime  @updatedAt
}

// Cada celular con la aplicación de autenticación (varios por cuenta)
model DispositivoVerificacion {
  id             Int       @id @default(autoincrement())
  cuenta         String    // misma referencia que SegundoFactor.cuenta
  nombre         String    // p. ej. "Celular de Juan"
  secretoCifrado String    // Secreto TOTP cifrado con AES-256-GCM
  confirmado     Boolean   @default(false) // true cuando se verificó el primer código
  ultimoPaso     Int?      // Último intervalo usado con este celular: evita reutilizar un código
  ultimoUso      DateTime?
  creadoEn       DateTime  @default(now())

  @@index([cuenta])
}

// ==========================================
// AUDITORÍA
// ==========================================
model Auditoria {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  cuenta      String   // Quién: "administrador", correo o "anonimo"
  rol         String?
  accion      String   // LOGIN_OK, LOGIN_FALLIDO, CREAR, EDITAR, ELIMINAR, ANULAR, 2FA_ACTIVADO, ...
  entidad     String?  // clientes, finanzas, inventario, ...
  entidadId   String?
  metodo      String?
  ruta        String?
  estadoHttp  Int?
  ip          String?
  detalle     Json?

  @@index([fecha])
  @@index([entidad, entidadId])
  @@index([accion])
}

// ==========================================
// FASE 2: CONTROL BANCARIO
// ==========================================
model CuentaBancaria {
  id                Int       @id @default(autoincrement())
  banco             String    // "BCP"
  nombre            String    // alias, p. ej. "BCP Soles principal"
  tipo              String    @default("CORRIENTE") // CORRIENTE, AHORROS, BILLETERA
  numero            String?   // número de cuenta (se muestra enmascarado)
  cci               String?
  moneda            String    @default("PEN") // PEN, USD
  saldoInicial      Decimal   @default(0) @db.Decimal(14, 2)
  fechaSaldoInicial DateTime?
  activa            Boolean   @default(true)
  creadoEn          DateTime  @default(now())
  mapeoExtracto     Json?     // columnas del extracto recordadas para la próxima importación

  movimientos       MovimientoBancario[]
  extractos         ExtractoBancario[]

  @@unique([banco, numero])
}

model MovimientoBancario {
  id                Int       @id @default(autoincrement())
  codigo            String    @unique // MB-2026-000123
  fecha             DateTime  // fecha y hora de la operación
  tipo              String    // INGRESO, EGRESO
  cuentaId          Int
  metodo            String    // TRANSFERENCIA, DEPOSITO, YAPE, PLIN, TARJETA, CHEQUE, OTRO
  contraparteNombre String?
  contraparteDoc    String?   // DNI o RUC
  clienteId         Int?
  monto             Decimal   @db.Decimal(14, 2)
  moneda            String    // PEN, USD (la de la cuenta)
  tipoCambio        Decimal?  @db.Decimal(10, 4)
  montoPen          Decimal   @db.Decimal(14, 2) // equivalente en soles (umbral y reportes)
  numeroOperacion   String?
  concepto          String
  categoria         String    @default("Otros")
  transaccionId     Int?      // venta o egreso ya registrado (no se duplica el ingreso)
  numeroGuiaId      Int?
  referenciaTexto   String?   // factura u otra referencia libre
  responsable       String    // quién lo registró
  observaciones     String?
  estado            String    @default("PENDIENTE") // PENDIENTE, CONCILIADO, DIFERENCIA, SIN_IDENTIFICAR, REQUIERE_REVISION, ANULADO
  fechaConciliacion DateTime?

  // Revisión administrativa (montoPen > umbral)
  requiereRevision  Boolean   @default(false)
  revisionEstado    String?   // PENDIENTE, REVISADO, OBSERVADO
  revisadoPor       String?
  revisadoEn        DateTime?
  notaRevision      String?

  // Anulación (las operaciones financieras no se eliminan)
  anuladoPor        String?
  anuladoEn         DateTime?
  motivoAnulacion   String?

  creadoEn          DateTime  @default(now())
  actualizadoEn     DateTime  @updatedAt

  cuenta            CuentaBancaria @relation(fields: [cuentaId], references: [id])
  cliente           Cliente?       @relation(fields: [clienteId], references: [id])
  transaccion       Transaccion?   @relation(fields: [transaccionId], references: [id])
  numeroGuia        NumeroGuia?    @relation(fields: [numeroGuiaId], references: [id])
  lineaExtracto     LineaExtracto?

  @@unique([cuentaId, numeroOperacion]) // el mismo n.º de operación no se registra dos veces en una cuenta
  @@index([fecha])
  @@index([estado])
  @@index([requiereRevision, revisionEstado])
  @@index([transaccionId])
}

// Archivos privados (comprobantes, facturas…) guardados en Backblaze B2 (o en disco local en desarrollo)
model Archivo {
  id             Int      @id @default(autoincrement())
  clave          String   @unique // ruta dentro del almacenamiento
  nombre         String   // nombre original
  mime           String
  tamano         Int
  sha256         String
  almacenamiento String   // local, s3
  entidad        String   // movimiento_bancario, …
  entidadId      Int
  subidoPor      String
  subidoEn       DateTime @default(now())
  eliminado      Boolean  @default(false)
  eliminadoPor   String?
  eliminadoEn    DateTime?

  @@index([entidad, entidadId])
  @@index([sha256])
}

// ==========================================
// FASE 2B: CONCILIACIÓN CON EXTRACTOS
// ==========================================
model ExtractoBancario {
  id             Int      @id @default(autoincrement())
  cuentaId       Int
  nombreArchivo  String
  archivoId      Int?     // archivo original guardado en el almacenamiento
  sha256         String   // huella del archivo: el mismo extracto no se importa dos veces
  desde          DateTime?
  hasta          DateTime?
  lineasTotales  Int      @default(0)
  lineasNuevas   Int      @default(0)
  lineasRepetidas Int     @default(0)
  importadoPor   String
  importadoEn    DateTime @default(now())

  cuenta         CuentaBancaria @relation(fields: [cuentaId], references: [id])
  lineas         LineaExtracto[]

  @@unique([cuentaId, sha256])
}

model LineaExtracto {
  id              Int       @id @default(autoincrement())
  extractoId      Int
  cuentaId        Int
  fecha           DateTime
  descripcion     String
  tipo            String    // INGRESO (abono), EGRESO (cargo)
  monto           Decimal   @db.Decimal(14, 2) // siempre positivo
  numeroOperacion String?
  saldo           Decimal?  @db.Decimal(14, 2)
  huella          String    // identifica la línea aunque venga en otro extracto que se solapa
  estado          String    @default("PENDIENTE") // PENDIENTE, CONCILIADO, DIFERENCIA, SIN_IDENTIFICAR, IGNORADO
  movimientoId    Int?      @unique
  conciliadoPor   String?
  conciliadoEn    DateTime?
  formaConciliacion String? // AUTOMATICA, MANUAL
  notaConciliacion String?

  extracto        ExtractoBancario    @relation(fields: [extractoId], references: [id])
  movimiento      MovimientoBancario? @relation(fields: [movimientoId], references: [id])

  @@unique([cuentaId, huella])
  @@index([cuentaId, estado])
  @@index([cuentaId, fecha])
}
