{
  "name": "jp_backend_nodejs",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc && shx cp -r src/templates dist/ && shx cp -r src/assets dist/",
    "start": "node dist/index.js",
    "studio": "npx prisma studio",
    "postinstall": "prisma generate",
    "test:fase0": "node --test --test-concurrency=1 tests/fase0.seguridad.test.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "admin:password": "node dist/scripts/resetAdminPassword.js",
    "admin:password:dev": "ts-node --transpile-only src/scripts/resetAdminPassword.ts",
    "dev:pruebas": "node scripts/dev-pruebas.mjs",
    "migracion:nueva": "node scripts/migracion-nueva.mjs",
    "admin:2fa:reset": "node dist/scripts/reset2FA.js",
    "admin:2fa:reset:dev": "ts-node --transpile-only src/scripts/reset2FA.ts",
    "test:fase1": "node --test --test-concurrency=1 tests/fase1.seguridad.test.mjs",
    "test:caja": "node --test --test-concurrency=1 tests/fase1.caja.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/pdfkit": "^0.17.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.3",
    "pdfkit": "^0.18.0",
    "puppeteer": "^24.40.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "^1.5.6",
    "embedded-postgres": "17.10.0-beta.17",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3"
  }
}
